{
    "cluster_url" = "{{ YT_PROXY_INTERNAL }}";
    "proxy_role" = "default";
    "path" = "{{ YT_DEV_ROOT }}/standalone_direct/pipeline";
    "rpc_port" = {{ FLOW_RPC_PORT }};
    "monitoring_port" = {{ FLOW_MONITORING_PORT }};
    "companion" = {
        "port" = {{ FLOW_COMPANION_PORT }};
        "monitoring_port" = {{ FLOW_COMPANION_MONITORING_PORT }};
    };
    "clients_cache" = {
        "default_connection" = {
            "enable_proxy_discovery" = %false;
            "proxy_addresses" = ["{{ YT_PROXY_RPC }}"];
        };
    };
    "address_resolver" = {
        "enable_ipv4" = %true;
        "enable_ipv6" = %false;
        "localhost_name_override" = "127.0.0.1";
    };
    "resource_tracker" = {
        "cpu_to_vcpu_factor" = 1.0;
    };
}

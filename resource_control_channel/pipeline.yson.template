{
    "cluster_url" = "${YT_PROXY_INTERNAL}";
    "proxy_role" = "default";
    "clients_cache" = {
        "default_connection" = {
            "enable_proxy_discovery" = %false;
            "proxy_addresses" = ["${YT_PROXY_RPC}"];
        };
    };
    "address_resolver" = {"enable_ipv4" = %true; "enable_ipv6" = %true;};
    "path" = "${YT_DEV_ROOT}/resource_control_channel/pipeline";
    "spec" = {
        "computations" = {
            "reader" = {
                "computation_class_name" = "NYT::NFlow::TSwiftPassthroughOrderedSourceComputation";
                "input_stream_ids" = [];
                "output_stream_ids" = ["data"];
                "source_streams" = {
                    "random" = {
                        "source_class_name" = "NYT::NFlow::TRandomSource";
                    };
                };
            };
            "consumer" = {
                "computation_class_name" = "NYT::NFlow::TProcessFunctionSwiftMapComputation";
                "processing_function" = "NYT::NFlow::NDemo::TNullFunction";
                "input_stream_ids" = ["data"];
                "group_by_schema" = [
                    {"name" = "hash"; "expression" = "farm_hash(key)"; "type" = "uint64"; "required" = %true;};
                    {"name" = "key"; "type" = "string";};
                ];
                "required_resource_ids" = {
                    "Counter" = {
                        "worker" = %true;
                        "controller" = %true;
                    };
                };
            };
        };
        "streams" = {
            "data" = {
                "schema" = [
                    {"name" = "key"; "type" = "string"; "required" = %true;};
                    {"name" = "data"; "type" = "string"; "required" = %true;};
                ];
            };
        };
        "resources" = {
            "Counter" = {
                "resource_class_name" = "NYT::NFlow::NDemo::TCounterResource";
                "always_on" = %true;
                "parameters" = {
                    "generation_period" = 3000;
                };
            };
        };
    };
    "dynamic_spec" = {
        "computations" = {
            "reader" = {
                "source_streams" = {
                    "random" = {
                        "parameters" = {
                            "partition_count" = 1;
                            "message_size_mean" = 100;
                            "message_count_mean" = 10;
                            "message_key_range" = 1000;
                        };
                    };
                };
            };
            "consumer" = {};
        };
    };
    "vanilla" = {
        "enable" = %true;
        "pool" = "${YT_POOL}";
        "worker" = {"count" = 2;};
        "node_config" = {"address_resolver" = {"enable_ipv4" = %true; "enable_ipv6" = %false;};};
        "proxy_url_aliasing_rules" = {"${YT_CLUSTER_NAME}" = "${YT_PROXY_INTERNAL}";};
    };
}

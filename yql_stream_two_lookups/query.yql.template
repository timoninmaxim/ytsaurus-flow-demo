use ytdemo;

pragma Engine = "ytflow";

pragma Ytflow.Cluster = "ytdemo";
pragma Ytflow.PipelinePath = "$PIPELINE_PATH";

pragma Ytflow.YtConsumerPath = "$SCENARIO_ROOT/main_consumer";
pragma Ytflow.YtProducerPath = "$SCENARIO_ROOT/main_producer";

pragma Ytflow.Pool = "$YT_POOL";

pragma Ytflow.ControllerRpcPort = "27130";
pragma Ytflow.ControllerMonitoringPort = "27131";
pragma Ytflow.WorkerRpcPort = "27132";
pragma Ytflow.WorkerMonitoringPort = "27133";

pragma Ytflow.ControllerCount = "1";
pragma Ytflow.ControllerCpuLimit = "1.0";
pragma Ytflow.ControllerMemoryLimit = "1G";

pragma Ytflow.WorkerCount = "1";
pragma Ytflow.WorkerCpuLimit = "1.0";
pragma Ytflow.WorkerMemoryLimit = "1G";

$input_stream =
    select
        key || "_before" as key_before,
        key,
        value
    from `$SCENARIO_ROOT/input_queue`
    where value > 2;

$joined_stream =
    select
        first_arg.key as key,
        first_arg.value as value,
        first_arg.key_before,
        second_arg.kv_value_a,
        third_arg.kv_value_b
    from $input_stream as first_arg
    inner join `$SCENARIO_ROOT/kv_table_a` as second_arg
    on first_arg.key = second_arg.key
    inner join `$SCENARIO_ROOT/kv_table_b` as third_arg
    on second_arg.key = third_arg.key;

insert into `$SCENARIO_ROOT/output_queue`
select
    key,
    value,
    `first_arg.key_before` as key_before,
    key || "_after" as key_after,
    `second_arg.kv_value_a` as kv_value_a,
    `third_arg.kv_value_b` as kv_value_b
from $joined_stream
where value * 2 <= `third_arg.kv_value_b`;

{
    "cluster_url" = "${YT_PROXY_INTERNAL}";
    "proxy_role" = "default";
    "clients_cache" = {
        "default_connection" = {
            "enable_proxy_discovery" = %false;
            "proxy_addresses" = ["${YT_PROXY_RPC}"];
        };
    };
    "address_resolver" = {"enable_ipv4" = %true; "enable_ipv6" = %true;};
    "path" = "${YT_DEV_ROOT}/table_injector/pipeline";
    "spec" = {
        "computations" = {
            "First" = {
                "computation_class_name" = "NYT::NFlow::TSwiftPassthroughOrderedSourceComputation";
                "input_stream_ids" = [];
                "output_stream_ids" = ["first"];
                "watermark_strategy" = {
                    "watermark_generator" = {
                        "out_of_orderness_bound" = 5000;
                        "unavailable_partition_groups" = {
                            "min_available_groups" = 0;
                        };
                    };
                };
                "source_streams" = {
                    "queue" = {
                        "source_class_name" = "NYT::NFlow::TQueueSource";
                        "parameters" = {
                            "queue_path" = "<cluster=${YT_CLUSTER_NAME}>${YT_DEV_ROOT}/table_injector/input_queue";
                            "consumer_path" = "<cluster=${YT_CLUSTER_NAME}>${YT_DEV_ROOT}/table_injector/consumer";
                            "finite" = %true;
                            "update_info_period" = 1000;
                        };
                    };
                };
            };
            "Second" = {
                "computation_class_name" = "NYT::NFlow::TPassthroughComputation";
                "use_compact_input_messages" = %false;
                "group_by_schema" = [
                    {"name" = "hash1"; "expression" = "farm_hash(data)"; "type" = "uint64"; "required" = %true;};
                    {"name" = "hash2"; "expression" = "farm_hash(data, 123)"; "type" = "uint64"; "required" = %true;};
                    {"name" = "data"; "type" = "string";};
                ];
                "input_stream_ids" = ["first"];
                "output_stream_ids" = ["output"];
                "sinks" = {
                    "queue" = {
                        "sink_class_name" = "NYT::NFlow::TAsyncQueueSink";
                        "input_stream_ids" = ["output"];
                        "parameters" = {
                            "queue_path" = "<cluster=${YT_CLUSTER_NAME}>${YT_DEV_ROOT}/table_injector/output_queue";
                            "producer_path" = "<cluster=${YT_CLUSTER_NAME}>${YT_DEV_ROOT}/table_injector/output_producer";
                        };
                    };
                };
            };
        };
        "streams" = {
            "first" = {
                "schema" = [
                    {"name" = "data"; "type" = "string";};
                ];
            };
            "output" = {
                "schema" = [
                    {"name" = "data"; "type" = "string";};
                ];
            };
        };
    };
    "dynamic_spec" = {
        "computations" = {
            "First" = {
                "batch_duration" = 100;
                "max_rows_per_batch" = 5;
                "parameters" = {
                    "desired_partition_count" = 1;
                };
                "source_streams" = {
                    "queue" = {
                        "parameters" = {
                            "unavailable_threshold" = 2000;
                        };
                    };
                };
            };
            "Second" = {
                "batch_duration" = 100;
                "parameters" = {
                    "desired_partition_count" = 5;
                };
            };
        };
        "message_distributor" = {
            "send_queue_max_rows_per_batch" = 50;
        };
    };
    "vanilla" = {
        "enable" = %true;
        "pool" = "${YT_POOL}";
        "worker" = {"count" = 1;};
        "node_config" = {"address_resolver" = {"enable_ipv4" = %true; "enable_ipv6" = %false;};};
        "proxy_url_aliasing_rules" = {"${YT_CLUSTER_NAME}" = "${YT_PROXY_INTERNAL}";};
    };
}

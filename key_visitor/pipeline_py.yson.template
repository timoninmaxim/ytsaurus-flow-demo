{
    "cluster_url" = "${YT_PROXY_INTERNAL}";
    "proxy_role" = "default";
    "clients_cache" = {
        "default_connection" = {
            "enable_proxy_discovery" = %false;
            "proxy_addresses" = ["${YT_PROXY_RPC}"];
        };
    };
    "address_resolver" = {"enable_ipv4" = %true; "enable_ipv6" = %true;};
    "path" = "${YT_DEV_ROOT}/key_visitor_py/pipeline";
    "spec" = {
        "computations" = {
            "key_reader" = {
                "computation_class_name" = "NYT::NFlow::TSwiftPassthroughOrderedSourceComputation";
                "input_stream_ids" = [];
                "output_stream_ids" = ["keys"];
                "source_streams" = {
                    "queue" = {
                        "source_class_name" = "NYT::NFlow::TQueueSource";
                        "parameters" = {
                            "queue_path" = "<cluster=${YT_CLUSTER_NAME}>${YT_DEV_ROOT}/key_visitor_py/input_queue";
                            "consumer_path" = "<cluster=${YT_CLUSTER_NAME}>${YT_DEV_ROOT}/key_visitor_py/consumer";
                            "finite" = %true;
                        };
                    };
                };
                "parameters" = {};
            };
            "tester" = {
                "computation_class_name" = "NYT::NFlow::NCompanion::TTransformCompanionComputation";
                "group_by_schema" = [
                    {"name" = "hash"; "expression" = "farm_hash(key)"; "type" = "uint64"; "required" = %true;};
                    {"name" = "key"; "type" = "string";};
                ];
                "input_stream_ids" = ["keys"];
                "output_stream_ids" = ["visits"];
                "key_visitor_streams" = {
                    "visit_iter" = {
                    };
                };
                "streams_dependency" = {
                    "visits" = ["keys"; "visit_iter"];
                };
                "required_resource_ids" = {
                    "CompanionManager" = {
                        "worker" = %true;
                        "controller" = %false;
                    };
                };
                "sinks" = {
                    "queue" = {
                        "sink_class_name" = "NYT::NFlow::TSyncQueueSink";
                        "input_stream_ids" = ["visits"];
                        "parameters" = {
                            "queue_path" = "<cluster=${YT_CLUSTER_NAME}>${YT_DEV_ROOT}/key_visitor_py/output_queue";
                        };
                    };
                };
                "parameters" = {
                    "internal_states" = ["user_state"];
                };
            };
        };
        "streams" = {
            "keys" = {
                "schema" = [
                    {"name" = "key"; "type" = "string";};
                    {"name" = "payload"; "type" = "string";};
                ];
            };
            "visits" = {
                "schema" = [
                    {"name" = "key"; "type" = "string";};
                    {"name" = "payload"; "type" = "string";};
                    {"name" = "visit_index"; "type" = "int64";};
                ];
            };
        };
        "resources" = {
            "CompanionManager" = {
                "resource_class_name" = "NYT::NFlow::NCompanion::TCompanionManager";
                "parameters" = {
                    "entrypoint" = {
                        "executable" = "./py_companion";
                    };
                };
                "dependencies" = {};
            };
        };
    };
    "dynamic_spec" = {
        "computations" = {
            "key_reader" = {
            };
            "tester" = {
                "key_visitor_streams" = {
                    "visit_iter" = {
                        "period" = 20000;
                    };
                };
            };
        };
        "job_tracker" = {
            "job_threads" = 4;
        };
    };
    "vanilla" = {
        "enable" = %true;
        "pool" = "${YT_POOL}";
        "controller" = {"count" = 1; "port_count" = 2;};
        "worker" = {
            "count" = 1;
            "port_count" = 3;
            "local_files" = {
                "py_companion" = "${SCENARIO_DIR}/companion_py/py_companion";
                "companion_bundle.tgz" = "${SCENARIO_DIR}/companion_py/companion_bundle.tgz";
            };
        };
        "node_config" = {"address_resolver" = {"enable_ipv4" = %true; "enable_ipv6" = %false;};};
        "proxy_url_aliasing_rules" = {"${YT_CLUSTER_NAME}" = "${YT_PROXY_INTERNAL}";};
    };
}

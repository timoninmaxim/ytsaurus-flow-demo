{
    "cluster_url" = "${YT_PROXY_INTERNAL}";
    "proxy_role" = "default";
    "clients_cache" = {
        "default_connection" = {
            "enable_proxy_discovery" = %false;
            "proxy_addresses" = ["${YT_PROXY_RPC}"];
        };
    };
    "address_resolver" = {"enable_ipv4" = %true; "enable_ipv6" = %true;};
    "path" = "${YT_DEV_ROOT}/word_count_sync/pipeline";
    "abort_on_specs_parseability_error" = %false;
    "spec" = {
        "computations" = {
            "reader" = {
                "computation_class_name" = "NYT::NFlow::NCompanion::TSwiftOrderedSourceCompanionComputation";
                "processing_function" = "NYT::NFlow::NDemo::TTextReadFunction";
                "output_stream_ids" = ["words"];
                "source_streams" = {
                    "queue" = {
                        "source_class_name" = "NYT::NFlow::TQueueSource";
                        "parameters" = {
                            "queue_path" = "<cluster=${YT_CLUSTER_NAME}>${YT_DEV_ROOT}/word_count_sync/input_queue";
                            "consumer_path" = "<cluster=${YT_CLUSTER_NAME}>${YT_DEV_ROOT}/word_count_sync/consumer";
                            "finite" = %true;
                        };
                    };
                };
                "required_resource_ids" = {
                    "CompanionManager" = {
                        "worker" = %true;
                        "controller" = %false;
                    };
                };
            };
            "counter" = {
                "computation_class_name" = "NYT::NFlow::NCompanion::TTransformCompanionComputation";
                "processing_function" = "NYT::NFlow::NDemo::TWordCountFunction";
                "processing_function_parameters" = {
                    "min_word_length" = 4;
                };
                "group_by_schema" = [
                    {"name" = "hash"; "expression" = "farm_hash(word)"; "type" = "uint64"; required = %true;};
                    {"name" = "word"; "type" = "string";};
                ];
                "input_stream_ids" = ["words"];
                "output_stream_ids" = ["skipped"];
                "external_state_managers" = {
                    "/state" = {
                        "external_state_manager_class_name" = "NYT::NFlow::TSimpleExternalStateManager";
                        "parameters" = {
                            "path" = "${YT_DEV_ROOT}/word_count_sync/word_counts";
                        };
                    };
                };
                "sinks" = {
                    "skipped_words" = {
                        "sink_class_name" = "NYT::NFlow::NSortedDynamicTable::TSyncSink";
                        "input_stream_ids" = ["skipped"];
                        "parameters" = {
                            "table_path" = "${YT_DEV_ROOT}/word_count_sync/skipped_words";
                        };
                    };
                };
                "required_resource_ids" = {
                    "CompanionManager" = {
                        "worker" = %true;
                        "controller" = %false;
                    };
                    "StopWords" = {
                        "worker" = %true;
                        "controller" = %false;
                    };
                };
            };
        };
        "streams" = {
            "words" = {
                "schema" = [
                    {"name" = "word"; "type" = "string";};
                ];
            };
            "skipped" = {
                "schema" = [
                    {"name" = "word"; "type" = "string";};
                    {"name" = "length"; "type" = "int64";};
                ];
            };
        };
        "resources" = {
            "CompanionManager" = {
                "resource_class_name" = "NYT::NFlow::NCompanion::TCompanionManager";
                "parameters" = {
                    "entrypoint" = {
                        "executable" = "./word_count_sync_companion";
                    };
                };
                "dependencies" = {};
            };
            "StopWords" = {
                "resource_class_name" = "NYT::NFlow::NCompanion::TCompanionResource";
                "parameters" = {
                    "companion_resource_class" = "NYT::NFlow::NDemo::TStopWordsResource";
                    "stop_words" = ["flow"; "to"];
                };
                "dependencies" = {
                    "CompanionManager" = {
                        "worker" = %true;
                        "controller" = %false;
                    };
                };
            };
        };
    };
    "dynamic_spec" = {
        "computations" = {
            "reader" = {
                "batch_duration" = 100;
                "parameters" = {
                    "desired_partition_count" = 1;
                };
            };
            "counter" = {
                "batch_duration" = 100;
                "parameters" = {
                    "desired_partition_count" = 5;
                };
            };
        };
        "job_tracker" = {
            "job_threads" = 4;
        };
    };
    "vanilla" = {
        "enable" = %true;
        "pool" = "${YT_POOL}";
        "controller" = {"count" = 1; "port_count" = 2;};
        "worker" = {
            "count" = 1;
            "port_count" = 3;
            "local_files" = {
                "word_count_sync_companion" = "${SCENARIO_DIR}/word_count_sync_companion.stripped";
            };
        };
        "node_config" = {
            "address_resolver" = {"enable_ipv4" = %true; "enable_ipv6" = %false;};
        };
        "proxy_url_aliasing_rules" = {"${YT_CLUSTER_NAME}" = "${YT_PROXY_INTERNAL}";};
    };
}
